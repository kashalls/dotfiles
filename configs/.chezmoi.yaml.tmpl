{{- $default := "linux" -}}
{{- if eq .chezmoi.os "windows" -}}
{{-   $default = "windows" -}}
{{- else if and (eq .chezmoi.os "linux") (contains "microsoft" (.chezmoi.kernel.osrelease | lower)) -}}
{{-   $default = "wsl" -}}
{{- end -}}
{{- $environment := promptChoiceOnce . "environment" "Environment" (list "windows" "wsl" "linux") $default -}}
{{- $name := promptStringOnce . "name" "Git name" "Devin Buhl" -}}
{{- $email := promptStringOnce . "email" "Git email" "devin@buhl.casa" -}}
format: yaml
data:
    environment: {{ $environment | quote }}
    name: {{ $name | quote }}
    email: {{ $email | quote }}